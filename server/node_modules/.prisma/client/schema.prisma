generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  password     String
  nickname     String
  avatar       String?
  phone        String?
  role         String   @default("BOSS")
  balance      Float    @default(0)
  isOnline     Boolean  @default(false)
  acceptOrders Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bossOrders             Order[]         @relation("BossOrders")
  proOrders              Order[]         @relation("ProOrders")
  sentMessages           Message[]       @relation("SentMessages")
  receivedMessages       Message[]       @relation("ReceivedMessages")
  certifications         Certification[] @relation("CertificationUser")
  certificationsReviewed Certification[] @relation("CertificationReviewer")
  skills                 ProSkill[]
  transactions           Transaction[]
  withdrawals            Withdrawal[]    @relation("WithdrawalUser")
  withdrawalsReviewed    Withdrawal[]    @relation("WithdrawalReviewer")
  reviews                Review[]        @relation("Reviewer")
  reviewsReceived        Review[]        @relation("Reviewee")
}

model Game {
  id          String   @id @default(uuid())
  name        String
  icon        String
  description String?
  category    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  skills ProSkill[]
  orders Order[]
}

model ProSkill {
  id           String   @id @default(uuid())
  proId        String
  gameId       String
  rank         String
  pricePerHour Float
  description  String?
  isCertified  Boolean  @default(false)
  createdAt    DateTime @default(now())

  pro    User    @relation(fields: [proId], references: [id])
  game   Game    @relation(fields: [gameId], references: [id])
  orders Order[]

  @@unique([proId, gameId])
}

model Certification {
  id         String    @id @default(uuid())
  userId     String
  type       String
  status     String    @default("PENDING")
  evidence   String
  remark     String?
  reviewerId String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  user     User  @relation("CertificationUser", fields: [userId], references: [id])
  reviewer User? @relation("CertificationReviewer", fields: [reviewerId], references: [id])
}

model Order {
  id          String    @id @default(uuid())
  orderNo     String    @unique
  bossId      String
  proId       String
  gameId      String
  skillId     String
  duration    Float
  amount      Float
  status      String    @default("PENDING")
  requirement String?
  progress    String?
  paidAt      DateTime?
  acceptedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  boss         User             @relation("BossOrders", fields: [bossId], references: [id])
  pro          User             @relation("ProOrders", fields: [proId], references: [id])
  game         Game             @relation(fields: [gameId], references: [id])
  skill        ProSkill         @relation(fields: [skillId], references: [id])
  transactions Transaction[]
  review       Review?
  statusLogs   OrderStatusLog[]
}

model OrderStatusLog {
  id        String   @id @default(uuid())
  orderId   String
  status    String
  remark    String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  type      String
  amount    Float
  balance   Float
  orderId   String?
  remark    String?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])
}

model Withdrawal {
  id          String    @id @default(uuid())
  userId      String
  amount      Float
  account     String
  accountName String
  status      String    @default("PENDING")
  reviewerId  String?
  reviewedAt  DateTime?
  remark      String?
  createdAt   DateTime  @default(now())

  user     User  @relation("WithdrawalUser", fields: [userId], references: [id])
  reviewer User? @relation("WithdrawalReviewer", fields: [reviewerId], references: [id])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model Review {
  id         String   @id @default(uuid())
  orderId    String   @unique
  reviewerId String
  revieweeId String
  rating     Int
  content    String?
  createdAt  DateTime @default(now())

  order    Order @relation(fields: [orderId], references: [id])
  reviewer User  @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewee User  @relation("Reviewee", fields: [revieweeId], references: [id])
}
