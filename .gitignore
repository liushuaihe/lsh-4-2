# ==============================================================================
# 全栈项目 .gitignore (Express + Vite + React + Prisma + SQLite)
# ==============================================================================

# 1. 依赖目录 (Node.js)
node_modules/
.pnp
.pnp.js

# 2. 环境变量 (⚠️非常重要：防止 JWT Secret 等敏感配置泄露)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# 3. SQLite 数据库文件 (⚠️非常重要：防止提交本地测试数据并覆盖线上数据)
*.db
*.db-journal
*.sqlite
*.sqlite3
# 如果你的 Prisma SQLite 数据库默认建在 prisma 目录下，取消下面两行的注释
# /prisma/*.db
# /prisma/*.db-journal

# 4. 编译与构建输出目录 (Express tsc / Vite build)
/dist
/build
/out
dist-ssr/

# 5. TypeScript 及 Vite 缓存
*.tsbuildinfo
.vite/
.eslintcache

# 6. 日志文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 7. 操作系统与编辑器生成的临时文件
.DS_Store
.DS_Store?
._*
.appleDouble
.LSOverride
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 8. 测试覆盖率报告 (如果你后续加入 Jest/Vitest)
coverage/